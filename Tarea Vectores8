#include <iostream>
using namespace std;

void leer(int v[], int &n);
void mostrar(int v[], int n);
void contarParesImpares(int v[], int n, int &pares, int &impares);

int main() {
    int n, pares = 0, impares = 0, vector[100];
    leer(vector, n);
    mostrar(vector, n);
    
    contarParesImpares(vector, n, pares, impares);
    
    cout << "Cantidad de numeros pares: " << pares << endl;
    cout << "Cantidad de numeros impares: " << impares << endl;
    return 0;
}

void leer(int v[], int &n) {
    cout << "Cantidad de elementos: "; cin >> n;
    for (int i = 0; i < n; i++) cin >> v[i];
}

void mostrar(int v[], int n) {
    cout << "Vector: [";
    for (int i = 0; i < n; i++) cout << v[i] << (i == n - 1 ? "" : ", ");
    cout << "]" << endl;
}

void contarParesImpares(int v[], int n, int &pares, int &impares) {
    for (int i = 0; i < n; i++) {
        if (v[i] % 2 == 0) pares++;
        else impares++;
    }
}
