#include <iostream>
using namespace std;

void leer(int v[], int &n);
void mostrar(int v[], int n);
void ordenarBurbuja(int v[], int n);

int main() {
    int n, vector[100];
    leer(vector, n);
    cout << "Vector original: " << endl;
    mostrar(vector, n);
    
    ordenarBurbuja(vector, n);
    
    cout << "Vector ordenado: " << endl;
    mostrar(vector, n);
    return 0;
}

void leer(int v[], int &n) {
    cout << "Cantidad de elementos: "; cin >> n;
    for (int i = 0; i < n; i++) cin >> v[i];
}

void mostrar(int v[], int n) {
    cout << "[";
    for (int i = 0; i < n; i++) cout << v[i] << (i == n - 1 ? "" : ", ");
    cout << "]" << endl;
}

void ordenarBurbuja(int v[], int n) {
    int aux;
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - 1 - i; j++) {
            if (v[j] > v[j + 1]) {
                aux = v[j];
                v[j] = v[j + 1];
                v[j + 1] = aux;
            }
        }
    }
}
