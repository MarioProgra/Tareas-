#include <iostream>
using namespace std;

int main() {
    int d1, m1, d2, m2;
    int total1, total2, diff;

    cout << "Ingrese la primera fecha (dia mes): ";
    cin >> d1 >> m1;

    cout << "Ingrese la segunda fecha (dia mes): ";
    cin >> d2 >> m2;

    total1 = (m1 * 30) + d1;
    total2 = (m2 * 30) + d2;

    diff = total2 - total1;

    cout << "Diferencia: "
         << diff / 30 << " meses "
         << diff % 30 << " dias" << endl;

    return 0;
}
