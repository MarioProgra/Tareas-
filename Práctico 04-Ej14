#include <iostream>
using namespace std;

int main() {
    int n, i;
    long long a = 1, b = 1, f = 1;

    cout << "Ingrese el valor de n: ";
    cin >> n;

    for (i = 2; i <= n; i++) {
        f = a + b;
        a = b;
        b = f;
    }

    cout << "El numero de Fibonacci F" << n
         << " es: " << f << endl;

    return 0;
}
