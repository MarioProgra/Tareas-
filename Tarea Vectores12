#include <iostream>
using namespace std;

void leer(int v[], int n, string nombre);
void mostrar(int v[], int n, string nombre);
void sumarVectores(int A[], int B[], int C[], int n);

int main() {
    int n;
    int A[100], B[100], C[100];
    
    cout << "Ingrese la cantidad de elementos para ambos vectores: ";
    cin >> n;
    
    leer(A, n, "Vector A");
    leer(B, n, "Vector B");
    
    sumarVectores(A, B, C, n);
    
    mostrar(C, n, "Vector Suma (A + B)");
    return 0;
}

void leer(int v[], int n, string nombre) {
    cout << "Ingresando datos de " << nombre << ":" << endl;
    for (int i = 0; i < n; i++) cin >> v[i];
}

void mostrar(int v[], int n, string nombre) {
    cout << nombre << ": [";
    for (int i = 0; i < n; i++) cout << v[i] << (i == n - 1 ? "" : ", ");
    cout << "]" << endl;
}

void sumarVectores(int A[], int B[], int C[], int n) {
    for (int i = 0; i < n; i++) {
        C[i] = A[i] + B[i];
    }
}
