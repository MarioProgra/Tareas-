#include <iostream>
using namespace std;

void leer(int v[], int &n);
void mostrar(int v[], int n);
void eliminarDuplicados(int v[], int &n);

int main() {
    int n, vector[100];
    leer(vector, n);
    
    cout << "Original:" << endl;
    mostrar(vector, n);
    
    eliminarDuplicados(vector, n);
    
    cout << "Sin duplicados:" << endl;
    mostrar(vector, n);
    
    return 0;
}

void leer(int v[], int &n) {
    cout << "Cantidad de elementos: "; cin >> n;
    for (int i = 0; i < n; i++) cin >> v[i];
}

void mostrar(int v[], int n) {
    cout << "[";
    for (int i = 0; i < n; i++) cout << v[i] << (i == n - 1 ? "" : ", ");
    cout << "]" << endl;
}

void eliminarDuplicados(int v[], int &n) {
    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            if (v[i] == v[j]) {
                for (int k = j; k < n - 1; k++) {
                    v[k] = v[k + 1]; // Desplazar izquierda
                }
                n--; 
                j--; // Revisar la nueva posición j
            }
        }
    }
}
