#include <iostream>
using namespace std;

int main() {
    int n, i;
    int divisores = 0;

    cout << "Ingrese un numero: ";
    cin >> n;

    for (i = 1; i <= n; i++) {
        if (n % i == 0) {
            divisores++;
        }
    }

    if (divisores == 2) {
        cout << n << " es primo" << endl;
    } else {
        cout << n << " no es primo" << endl;
    }

    return 0;
}
