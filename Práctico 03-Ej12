#include <iostream>
using namespace std;

int main() {
    int total_minutos, dias, horas, minutos;

    cout << "Ingrese la cantidad de minutos: ";
    cin >> total_minutos;

    dias = total_minutos / (24 * 60);
    horas = (total_minutos % (24 * 60)) / 60;
    minutos = total_minutos % 60;

    cout << dias << " dias, "
         << horas << " horas, "
         << minutos << " minutos" << endl;

    return 0;
}
