#include <iostream>
using namespace std;

int main() {
    int n, i;
    int signo = 1;
    double x, potencia = 1, factorial = 1, s = 0;

    cout << "Ingrese X: ";
    cin >> x;

    cout << "Ingrese N: ";
    cin >> n;

    for (i = 1; i <= n; i++) {
        potencia = potencia * x;
        factorial = factorial * i;
        s = s + signo * potencia / factorial;
        signo = -signo;
    }

    cout << "S = " << s << endl;

    return 0;
}
