#include <iostream>

using namespace std;

void SISTEMA(double A, double B, double C, double D, double E, double F, double &X, double &Y) {
    double termino_indep1 = -C;
    double termino_indep2 = -F;
    double determinante = (A * E) - (B * D);
    
    if (determinante != 0) {
        X = ((termino_indep1 * E) - (B * termino_indep2)) / determinante;
        Y = ((A * termino_indep2) - (termino_indep1 * D)) / determinante;
        cout << "Solucion del sistema: X = " << X << ", Y = " << Y << endl;
    } else {
        cout << "El sistema no tiene solucion unica." << endl;
    }
}

int main() {
    double X, Y;
    cout << "Calculando el sistema de prueba del practico..." << endl;
    SISTEMA(1, 2, 3, 4, 5, 6, X, Y);
    return 0;
}
