#include <iostream>
using namespace std;

void leer(int v[], int &n);
void mostrar(int v[], int n, string nombre);
void separarParesImpares(int v[], int n, int pares[], int &nPares, int impares[], int &nImpares);

int main() {
    int n, nPares = 0, nImpares = 0;
    int vector[100], pares[100], impares[100];
    
    leer(vector, n);
    separarParesImpares(vector, n, pares, nPares, impares, nImpares);
    
    mostrar(vector, n, "Original");
    mostrar(pares, nPares, "Solo Pares");
    mostrar(impares, nImpares, "Solo Impares");
    
    return 0;
}

void leer(int v[], int &n) {
    cout << "Cantidad de elementos: "; cin >> n;
    for (int i = 0; i < n; i++) cin >> v[i];
}

void mostrar(int v[], int n, string nombre) {
    cout << nombre << ": [";
    for (int i = 0; i < n; i++) cout << v[i] << (i == n - 1 ? "" : ", ");
    cout << "]" << endl;
}

void separarParesImpares(int v[], int n, int pares[], int &nPares, int impares[], int &nImpares) {
    for (int i = 0; i < n; i++) {
        if (v[i] % 2 == 0) {
            pares[nPares++] = v[i];
        } else {
            impares[nImpares++] = v[i];
        }
    }
}
