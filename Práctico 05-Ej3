#include <iostream>
using namespace std;

int main() {
    int n, digito, pares = 0;

    cout << "Ingrese un numero: ";
    cin >> n;

    while (n > 0) {
        digito = n % 10;
        if (digito % 2 == 0) {
            pares++;
        }
        n = n / 10;
    }

    cout << "Cantidad de digitos pares: " << pares << endl;
    return 0;
}
