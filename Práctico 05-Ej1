#include <iostream>
using namespace std;

int main() {
    int n, digito, suma = 0;

    cout << "Ingrese un numero: ";
    cin >> n;

    while (n > 0) {
        digito = n % 10;     // ultimo digito
        suma = suma + digito;
        n = n / 10;          // quitamos el ultimo digito
    }

    cout << "La suma de los digitos es: " << suma << endl;
    return 0;
}
