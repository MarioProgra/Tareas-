Algoritmo TotalCompra
    Definir cantidad Como Entero
    Definir precioUnitario, total Como Entero

    precioUnitario <- 12

    Escribir "Ingrese la cantidad de cuadernos a comprar"
    Leer cantidad

    total <- cantidad * precioUnitario

    Escribir "El total a pagar es: ", total, " Bs"
FinAlgoritmo
