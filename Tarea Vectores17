#include <iostream>
using namespace std;

void leer(int v[], int n, string nombre);
int productoEscalar(int A[], int B[], int n);

int main() {
    int n;
    int A[100], B[100];
    
    cout << "Cantidad de elementos para ambos vectores: ";
    cin >> n;
    
    leer(A, n, "Vector A");
    leer(B, n, "Vector B");
    
    cout << "El producto escalar es: " << productoEscalar(A, B, n) << endl;
    
    return 0;
}

void leer(int v[], int n, string nombre) {
    cout << "Ingresando " << nombre << endl;
    for (int i = 0; i < n; i++) cin >> v[i];
}

int productoEscalar(int A[], int B[], int n) {
    int suma = 0;
    for (int i = 0; i < n; i++) {
        suma += A[i] * B[i];
    }
    return suma;
}
