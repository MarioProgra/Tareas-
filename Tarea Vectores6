#include <iostream>
using namespace std;

void leer(int v[], int &n);
void mostrar(int v[], int n);
int buscarElemento(int v[], int n, int x);

int main() {
    int n, x, vector[100];
    leer(vector, n);
    mostrar(vector, n);
    cout << "Ingrese el elemento a buscar: ";
    cin >> x;
    
    int pos = buscarElemento(vector, n, x);
    if (pos != -1) cout << "Elemento encontrado en el indice: " << pos << endl;
    else cout << "Elemento NO encontrado en el vector." << endl;
    return 0;
}

void leer(int v[], int &n) {
    cout << "Cantidad de elementos: "; cin >> n;
    for (int i = 0; i < n; i++) cin >> v[i];
}

void mostrar(int v[], int n) {
    cout << "Vector: [";
    for (int i = 0; i < n; i++) cout << v[i] << (i == n - 1 ? "" : ", ");
    cout << "]" << endl;
}

int buscarElemento(int v[], int n, int x) {
    for (int i = 0; i < n; i++) {
        if (v[i] == x) return i; // Retorna la posición si lo encuentra
    }
    return -1; // Retorna -1 si no existe
}
