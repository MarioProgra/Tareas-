#include <iostream>
using namespace std;

void leer(int v[], int &n);
void mostrar(int v[], int n);
void insertarPosicion(int v[], int &n, int pos, int valor);

int main() {
    int n, pos, valor, vector[100];
    leer(vector, n);
    mostrar(vector, n);
    
    cout << "Ingrese el indice para insertar (0 a " << n << "): ";
    cin >> pos;
    cout << "Ingrese el valor a insertar: ";
    cin >> valor;
    
    if (pos >= 0 && pos <= n && n < 100) {
        insertarPosicion(vector, n, pos, valor);
        cout << "Vector tras la insercion: " << endl;
        mostrar(vector, n);
    } else {
        cout << "Indice o capacidad fuera de rango." << endl;
    }
    
    return 0;
}

void leer(int v[], int &n) {
    cout << "Cantidad de elementos: "; cin >> n;
    for (int i = 0; i < n; i++) cin >> v[i];
}

void mostrar(int v[], int n) {
    cout << "[";
    for (int i = 0; i < n; i++) cout << v[i] << (i == n - 1 ? "" : ", ");
    cout << "]" << endl;
}

void insertarPosicion(int v[], int &n, int pos, int valor) {
    for (int i = n; i > pos; i--) {
        v[i] = v[i - 1]; // Desplaza a la derecha
    }
    v[pos] = valor;
    n++; // Aumenta el tamaño lógico del vector
}
