#include <iostream>
using namespace std;

void leer(int v[], int &n);
void mostrar(int v[], int n);
int contarFrecuencia(int v[], int n, int x);

int main() {
    int n, x, vector[100];
    leer(vector, n);
    mostrar(vector, n);
    
    cout << "Ingrese el elemento a contar: ";
    cin >> x;
    
    int cantidad = contarFrecuencia(vector, n, x);
    cout << "El elemento " << x << " aparece " << cantidad << " vez/veces." << endl;
    
    return 0;
}

void leer(int v[], int &n) {
    cout << "Cantidad de elementos: "; cin >> n;
    for (int i = 0; i < n; i++) cin >> v[i];
}

void mostrar(int v[], int n) {
    cout << "Vector: [";
    for (int i = 0; i < n; i++) cout << v[i] << (i == n - 1 ? "" : ", ");
    cout << "]" << endl;
}

int contarFrecuencia(int v[], int n, int x) {
    int contador = 0;
    for (int i = 0; i < n; i++) {
        if (v[i] == x) contador++;
    }
    return contador;
}
