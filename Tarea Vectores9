#include <iostream>
using namespace std;

void leer(int v[], int &n);
void mostrar(int v[], int n);
void eliminarPosicion(int v[], int &n, int pos);

int main() {
    int n, pos, vector[100];
    leer(vector, n);
    mostrar(vector, n);
    
    cout << "Ingrese el indice a eliminar (0 a " << n - 1 << "): ";
    cin >> pos;
    
    if (pos >= 0 && pos < n) {
        eliminarPosicion(vector, n, pos);
        cout << "Vector tras eliminacion: " << endl;
        mostrar(vector, n);
    } else {
        cout << "Indice fuera de rango." << endl;
    }
    
    return 0;
}

void leer(int v[], int &n) {
    cout << "Cantidad de elementos: "; cin >> n;
    for (int i = 0; i < n; i++) cin >> v[i];
}

void mostrar(int v[], int n) {
    cout << "[";
    for (int i = 0; i < n; i++) cout << v[i] << (i == n - 1 ? "" : ", ");
    cout << "]" << endl;
}

void eliminarPosicion(int v[], int &n, int pos) {
    for (int i = pos; i < n - 1; i++) {
        v[i] = v[i + 1];
    }
    n--; // Se reduce el tamaño lógico del vector
}
